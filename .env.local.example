NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

RESEND_API_KEY=
RESEND_FROM_EMAIL=RidgeTheory <hello@your-verified-domain.com>
# Optional. If set, overrides RESEND_FROM_EMAIL. Leave unset until you have a verified outreach address.

REOON_API_KEY=
REOON_VERIFY_MODE=power

RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

OUTREACH_PHONE=(424) 273-5737

# ── Dialer (Prospecting → Call step; ported from Call_Number_Rotation) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# TwiML App whose Voice Request URL is {TWILIO_WEBHOOK_BASE_URL}/api/twilio/voice (POST)
TWILIO_TWIML_APP_SID=
# Public URL Twilio can reach. Locally, use a tunnel (e.g. `ngrok http 3000`) and paste its https URL.
TWILIO_WEBHOOK_BASE_URL=
# Conference mode enables the IVR keypad and call recording.
TWILIO_CONFERENCE_CALLS=true
# Optional: Voice SDK edge nearest your reps (default singapore), and timezone for daily DID caps (default Asia/Manila).
# NEXT_PUBLIC_TWILIO_EDGE=ashburn
# DIALER_TIMEZONE=America/Los_Angeles
# Set to false only if a proxy rewrites webhook URLs and breaks Twilio signature checks.
# TWILIO_VALIDATE_WEBHOOKS=false
